{
  "manifest_version": 3,
  "name": "TCG Vorbestellungen – etron-Verbindung",
  "short_name": "Vorbestellungen etron",
  "version": "1.4",
  "description": "Erlaubt der App „TCG Vorbestellungen“, mit eurer etron-onRetail-Instanz zu sprechen und Artikelseiten von heo, Cubegolem und WPN auszulesen. Sonst nichts.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.wawi.onretail.eu/*",
    "https://heo.com/*",
    "https://*.heo.com/*",
    "https://heomedia.com/*",
    "https://*.heomedia.com/*",
    "https://cubegolem.si/*",
    "https://*.cubegolem.si/*",
    "https://wpn.wizards.com/*",
    "https://*.wizards.com/*",
    "https://images.ctfassets.net/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://electronicfallout.github.io/*"
    ]
  },
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": [
    "scripting"
  ]
}
