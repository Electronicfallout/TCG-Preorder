{
  "manifest_version": 3,
  "name": "TCG Vorbestellungen – etron-Verbindung",
  "short_name": "Vorbestellungen etron",
  "version": "1.1",
  "description": "Erlaubt der App „TCG Vorbestellungen“, mit eurer etron-onRetail-Instanz zu sprechen und heo-Artikelseiten auszulesen. Sonst nichts.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.wawi.onretail.eu/*",
    "https://heo.com/*",
    "https://*.heo.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://electronicfallout.github.io/*"
    ]
  },
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": [
    "scripting"
  ]
}
